      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 334587839104932612, guid: b4a6190ab81125243bb636d79e84fc72, type: 3}
      propertyPath: monologueTxt
      value: 
      objectReference: {fileID: 2082034145}
    - target: {fileID: 334587839104932612, guid: b4a6190ab81125243bb636d79e84fc72, type: 3}
      propertyPath: monologuePanel
      value: 
      objectReference: {fileID: 1494262381}
    - target: {fileID: 334587839104932612, guid: b4a6190ab81125243bb636d79e84fc72, type: 3}
      propertyPath: monologueData.monologueLines.Array.size
      value: 8
      objectReference: {fileID: 0}
    - target: {fileID: 334587839104932612, guid: b4a6190ab81125243bb636d79e84fc72, type: 3}
      propertyPath: monologueData.monologueLines.Array.data[0].line
      value: "Meu deus... onde \xE9 que eu t\xF4? Eu lembro que tava navegando e..."
      objectReference: {fileID: 0}
    - target: {fileID: 334587839104932612, guid: b4a6190ab81125243bb636d79e84fc72, type: 3}
      propertyPath: monologueData.monologueLines.Array.data[1].line
      value: Tinha uma neblina muito forte...
      objectReference: {fileID: 0}
    - target: {fileID: 334587839104932612, guid: b4a6190ab81125243bb636d79e84fc72, type: 3}
      propertyPath: monologueData.monologueLines.Array.data[2].line
      value: "Que droga. Cad\xEA o meu barco?"
      objectReference: {fileID: 0}
    - target: {fileID: 334587839104932612, guid: b4a6190ab81125243bb636d79e84fc72, type: 3}
      propertyPath: monologueData.monologueLines.Array.data[3].line
      value: "E cad\xEA a minha tripula\xE7\xE3o?!"
      objectReference: {fileID: 0}
    - target: {fileID: 334587839104932612, guid: b4a6190ab81125243bb636d79e84fc72, type: 3}
      propertyPath: monologueData.monologueLines.Array.data[4].line
      value: Sarah... Tony...
      objectReference: {fileID: 0}
    - target: {fileID: 334587839104932612, guid: b4a6190ab81125243bb636d79e84fc72, type: 3}
      propertyPath: monologueData.monologueLines.Array.data[5].line
      value: Meu deus, espero que estejam bem em algum lugar.
      objectReference: {fileID: 0}
    - target: {fileID: 334587839104932612, guid: b4a6190ab81125243bb636d79e84fc72, type: 3}
      propertyPath: monologueData.monologueLines.Array.data[6].line
      value: "Parece que t\xF4 sozinho aqui..."
      objectReference: {fileID: 0}
    - target: {fileID: 334587839104932612, guid: b4a6190ab81125243bb636d79e84fc72, type: 3}
      propertyPath: monologueData.monologueLines.Array.data[7].line
      value: "Bom, me mandaram aqui para estudar esse lugar, ent\xE3o..."
      objectReference: {fileID: 0}
    - target: {fileID: 3451662537103808884, guid: b4a6190ab81125243bb636d79e84fc72, type: 3}
      propertyPath: m_Name
      value: "monologueTrigger - In\xEDcio"
